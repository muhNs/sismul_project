export default function ArenaPage() {
  const {
    currentQuestion,
    selectedOption,
    checked,
    showScorePopup,
    shakeOption,
    progressPercent,
    totalPoints,
    resetQuiz,
    handleSelectOption,
    handleCheckAnswer,
    handleNext,
    handleClose,
  } = useQuiz();

  useEffect(() => {
    resetQuiz();
